<% layout("/layouts/boilerplate")%>
<body>
    <div class="row">
        <h3>Create a new listing</h3>
        <form method="POST" action="/listings" novalidate class="needs-validation">
            <div class="mb-3">
                <label for="title" class="form-label">title</label>
                <input name="listing[title]" placeholder="enter name of the title" type="text" class="form-control" required/>
                <div class="valid-feedback">title is looks good</div>
                <div class="invalid-feedback">title should be valid</div>
            </div>
            <br><br/>
            <div class="mb-3">
                <label for="description" class="form-label">description</label>
                <textarea name="listing[description]" class="form-control" required></textarea>
                <div class="invalid-feedback">description should be short</div>
            </div>
            <br><br/>
            <div class="mb-3">
                <label for="image" class="form-label">image link</label>
                <input name="listing[image]" placeholder="enter image URL/link" type="text" class="form-control">
            </div>
            <br><br/>
            <div class="mb-3">
                <label for="price" class="form-label">price</label>
                <input name="listing[price]" placeholder="enter price" type="number" class="form-control" required/>
                <div class="invalid-feedback">price is not valid</div>
            </div>
            <br><br/>
            <div class="mb-3">
                <label for="country" class="form-label">country</label>
                <input name="listing[country]" placeholder="enter country name" type="text" class="form-control" required/>
                <div class="invalid-feedback"> country name should be valid</div>
            </div>
            <br><br/>
            <div class="mb-3">
                <label for="location" class="form-label">location</label>
                <input name="listing[location]" placeholder="enter location" type="text" class="form-control" required/>
                <div class="invalid-feedback">location should be valid</div>
            </div>
            <br><br/>
            <button class="btn btn-dark">Add</button>
        </form>
    </div>
</body>
